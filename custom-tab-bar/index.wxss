@import "../theme.wxss";

/* 凸起选中：圆钮滑过底栏，两侧反向圆角收成弧；动效只动 transform/opacity */
.tb {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  height: calc(86px + env(safe-area-inset-bottom));
  font-family: var(--font);
}
.sheet {
  position: absolute; left: 0; right: 0; top: 32px; bottom: 0;
  background: var(--card);
  box-shadow: 0 -10px 28px rgba(14, 26, 25, .07);
}
.dark .sheet { box-shadow: 0 -10px 28px rgba(0, 0, 0, .38); }
.glide {
  position: absolute; z-index: 2;
  top: 4px; left: 0;
  width: 25%; height: 56px;
  pointer-events: none;
  transition: none;
  will-change: transform;
}
/* Expo.out —— 滑入丝滑；跨多格略加长，更有物理感 */
.glide.anim {
  transition: transform .38s cubic-bezier(.16, 1, .3, 1);
}
.glide.anim.span2 { transition-duration: .46s; }
.glide.anim.span3 { transition-duration: .54s; }
.g0 { transform: translate3d(0, 0, 0); }
.g1 { transform: translate3d(100%, 0, 0); }
.g2 { transform: translate3d(200%, 0, 0); }
.g3 { transform: translate3d(300%, 0, 0); }
.bump {
  position: absolute; left: 50%; top: 0;
  width: 56px; height: 56px; margin-left: -28px;
  border-radius: 50%;
  background: var(--pri);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10px 20px rgba(14, 26, 25, .18);
  transform: scale(1);
  will-change: transform;
}
.dark .bump { background: var(--g1); box-shadow: 0 10px 20px rgba(0, 0, 0, .45); }
.bump-ic {
  position: relative; z-index: 1;
  width: 26px; height: 26px;
  opacity: 1;
  transform: scale(1);
  transition: opacity .18s cubic-bezier(.16, 1, .3, 1),
              transform .28s cubic-bezier(.34, 1.4, .64, 1);
}
/* 落地轻弹：只在真正换 Tab 时触发 */
.glide.pop .bump {
  animation: bump-settle .48s cubic-bezier(.34, 1.45, .64, 1) both;
}
.glide.pop .bump-ic {
  animation: icon-settle .42s cubic-bezier(.34, 1.45, .64, 1) .04s both;
}
@keyframes bump-settle {
  0%   { transform: scale(.9); box-shadow: 0 4px 10px rgba(14, 26, 25, .1); }
  58%  { transform: scale(1.07); box-shadow: 0 14px 26px rgba(14, 26, 25, .22); }
  100% { transform: scale(1); box-shadow: 0 10px 20px rgba(14, 26, 25, .18); }
}
@keyframes icon-settle {
  0%   { opacity: .35; transform: scale(.82); }
  60%  { opacity: 1; transform: scale(1.08); }
  100% { opacity: 1; transform: scale(1); }
}
.dark .glide.pop .bump {
  animation-name: bump-settle-dark;
}
@keyframes bump-settle-dark {
  0%   { transform: scale(.9); box-shadow: 0 4px 10px rgba(0, 0, 0, .28); }
  58%  { transform: scale(1.07); box-shadow: 0 14px 26px rgba(0, 0, 0, .5); }
  100% { transform: scale(1); box-shadow: 0 10px 20px rgba(0, 0, 0, .45); }
}
/* 透明块 + 同色投影，圆角把投影切成凹弧，露出页面背景 */
.curve {
  position: absolute; z-index: 0;
  width: 18px; height: 18px; bottom: 0;
  background: transparent;
}
.curve-l {
  left: -16px;
  border-top-right-radius: 18px;
  box-shadow: 0 -10px 0 0 var(--card);
}
.curve-r {
  right: -16px;
  border-top-left-radius: 18px;
  box-shadow: 0 -10px 0 0 var(--card);
}
.row {
  position: absolute; z-index: 3;
  left: 0; right: 0; top: 32px; bottom: 0;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab {
  flex: 1; min-height: 48px;
  display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
  gap: 3px; padding-bottom: 8px;
  color: var(--ink3); font-size: 12px; font-weight: 600; letter-spacing: .1px;
}
.tab text {
  transition: color .36s cubic-bezier(.16, 1, .3, 1),
              transform .36s cubic-bezier(.16, 1, .3, 1),
              opacity .24s ease;
  transform: translate3d(0, 0, 0);
}
.tab.on { color: var(--priInk); }
.tab.on text { transform: translate3d(0, -1px, 0); }
/* 按下：只缩图标区，不挪布局 */
.tab.press:not(.on) .tic { transform: scale(.9); }
.tab.press:not(.on) text { opacity: .62; }
.tab.press.on .bump-ic,
.hv-tab { opacity: .88; }
.tic {
  width: 24px; height: 24px;
  transition: transform .22s cubic-bezier(.16, 1, .3, 1);
}
.tic-ic {
  width: 24px; height: 24px;
  transition: opacity .3s cubic-bezier(.16, 1, .3, 1);
}
.tab.on .tic-ic { opacity: 0; transition-duration: .18s; }
.tb.elder { height: calc(96px + env(safe-area-inset-bottom)); }
.tb.elder .tab { font-size: 15px; font-weight: 700; padding-bottom: 10px; }
.tb.elder .sheet,
.tb.elder .row { top: 36px; }

@media (prefers-reduced-motion: reduce) {
  .glide.anim,
  .tic,
  .tic-ic,
  .tab text,
  .bump-ic { transition: none !important; }
  .glide.pop .bump,
  .glide.pop .bump-ic { animation: none !important; }
}
