.todo-actions { display: flex; gap: 10px; margin: 14px 16px 0; }
.todo-actions .btn-save { flex: 1; width: auto; margin: 0; padding: 13px 8px; font-size: 15px; }
.todo-ghost {
  flex: 1; border-radius: var(--r-md); padding: 13px 8px; font-size: 15px; font-weight: 700;
  text-align: center; color: var(--priInk); background: var(--card);
  box-shadow: var(--sh1); line-height: 1.4;
}
.hv-ghost { opacity: .72; }
.todo-check {
  width: 44px; height: 44px; margin: -6px -8px -6px -6px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; flex: none;
}
.todo-check .box {
  width: 22px; height: 22px; border-radius: 50%;
  box-shadow: inset 0 0 0 1.5px var(--ink3);
  display: flex; align-items: center; justify-content: center;
}
.todo-check.on .box { background: var(--pri); box-shadow: none; }
.todo-check .tick { width: 13px; height: 13px; }
.todo-form-actions { display: flex; gap: 10px; padding: 4px 16px 16px; }
.todo-form-actions .btn-save { flex: 1; width: auto; margin: 0; }
.todo-link {
  flex: none; min-width: 72px; border-radius: var(--r-md); padding: 16px 12px;
  text-align: center; font-size: 15px; font-weight: 700; color: var(--ink2);
  background: var(--fill);
}
.todo-link.danger { color: var(--danger); }
.rt.done { color: var(--ink3); text-decoration: line-through; }
.todo-due { color: var(--priInk); }
.todo-cal { width: 14px; height: 14px; flex: none; }
.todo-hint { margin: 10px 20px 0; font-size: 12px; font-weight: 500; color: var(--ink3); }
.fhint-pad { padding: 0 16px 12px; }

/* 距下次接种横幅 */
.vac-banner {
  display: flex; align-items: center; gap: 12px;
  margin: 12px 16px 0; padding: 13px 14px;
  border-radius: var(--r-md); background: var(--growthS);
  box-shadow: var(--sh1);
}
.vac-ic { font-size: 22px; flex: none; line-height: 1; }
.vac-b { flex: 1; min-width: 0; }
.vac-t { font-size: 13px; font-weight: 700; color: var(--growth); }
.vac-n { color: var(--growth); font-weight: 800; }
.vac-s { font-size: 12px; color: var(--ink2); margin-top: 2px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 疫苗剂次标签 */
.vac-tag {
  display: inline-block; font-size: 10.5px; font-weight: 800; line-height: 1.5;
  padding: 0 6px; margin-right: 6px; border-radius: 6px;
  color: var(--growth); background: var(--growthS); vertical-align: 1px;
}
