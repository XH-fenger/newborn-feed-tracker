<view class="page stats-page t-{{theme}} {{dark ? 'dark' : ''}} {{elder ? 'elder' : ''}}">

  <view class="nav {{navSc ? 'sc' : ''}}" style="padding-top:{{sbH}}px">
    <view class="nav-row nav-row-pad" style="min-height:{{navH}}px">
      <view class="nav-mid nav-mid-left">{{navMeta}}</view>
    </view>
  </view>

  <view class="stats-pin" style="top:{{sbH + navH + 9}}px">
    <view class="seg seg-5">
      <view class="seg-thumb" style="transform:translateX({{segIndex * 100}}%)"></view>
      <view
        wx:for="{{segs}}" wx:key="k"
        class="seg-item {{seg === item.k ? 'on' : ''}}"
        hover-class="hv-seg" hover-stay-time="60"
        data-k="{{item.k}}" data-i="{{index}}"
        bindtap="onSegTap"
      >{{item.t}}</view>
    </view>
  </view>

  <scroll-view class="stats-scroll" scroll-y style="top:{{sbH + navH + 79}}px;height:{{scrollH}}px" bindscroll="onBodyScroll">

    <!-- ============ 区间（近 7 / 30 天 / 自定义） ============ -->
    <view class="rng anim" wx:if="{{seg !== 'growth'}}">
      <view class="seg-inline">
        <view class="si {{rangeMode==='7'?'on':''}}" data-k="7" bindtap="onRangeTap">近7天</view>
        <view class="si {{rangeMode==='30'?'on':''}}" data-k="30" bindtap="onRangeTap">近30天</view>
        <view class="si {{rangeMode==='custom'?'on':''}}" data-k="custom" bindtap="onRangeTap">自定义</view>
      </view>
      <view class="rng-pick" wx:if="{{rangeMode==='custom'}}">
        <picker mode="date" value="{{rangeStart}}" bindchange="onRangeStart"><view class="rp">{{rangeStart||'起始日'}}</view></picker>
        <text class="rp-sep">—</text>
        <picker mode="date" value="{{rangeEnd}}" bindchange="onRangeEnd"><view class="rp">{{rangeEnd||'结束日'}}</view></picker>
      </view>
    </view>

    <!-- ============ 环比（较上一周期） ============ -->
    <view class="cmpbar anim {{cmpOpen ? '' : 'shut'}}" wx:if="{{seg !== 'growth' && cmp.has}}">
      <view class="cmp-h" hover-class="hv-row" hover-stay-time="60" bindtap="toggleCmp">
        <text>较上一周期（{{cmp.n}} 天 · 日均对比）</text>
        <text class="cmp-chev {{cmpOpen ? 'open' : ''}}">›</text>
      </view>
      <view class="cmp-row" wx:if="{{cmpOpen}}">
        <view class="cmp-i {{seg === item.seg ? 'on' : ''}}" wx:for="{{cmp.items}}" wx:key="k" hover-class="hv-row" hover-stay-time="60" data-k="{{item.seg}}" bindtap="onCmpTap">
          <view class="cmp-k">{{item.k}}</view>
          <view class="cmp-v {{item.dir}}">{{item.txt}}</view>
          <view class="cmp-s">{{item.prev}} → {{item.cur}}</view>
        </view>
      </view>
    </view>

    <!-- ============ 喂养 ============ -->
    <view class="chartcard anim" wx:if="{{seg === 'feed'}}">
      <view class="ch-h">
        <view>
          <view class="h3">每日总奶量</view>
          <view class="sub">点选某一天查看明细</view>
        </view>
        <view class="chip" wx:if="{{feed.has}}">日均 {{feed.avg}} ml</view>
      </view>
      <block wx:if="{{feed.has}}">
        <view class="chart-box">
          <canvas type="2d" id="chCv" class="chart"></canvas>
          <view class="chart-hits">
            <view class="chart-hit" wx:for="{{chartRows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-hit" hover-stay-time="80" aria-role="button" aria-label="查看{{item.d}}" bindtap="onDayTap"></view>
          </view>
        </view>
        <view class="kpis">
          <view class="kpi" wx:for="{{feed.kpis}}" wx:key="k">
            <view class="kv">{{item.v}}<small>{{item.u}}</small></view>
            <view class="kl">{{item.k}}</view>
          </view>
        </view>
        <view class="dlist">
          <view class="drow {{dayKey === item.key ? 'on' : ''}}" wx:for="{{feed.rows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-row" hover-stay-time="60" bindtap="onDayTap">
            <text class="dd">{{item.d}}</text>
            <view class="dbar"><view class="di" style="width:{{item.p}}%;background:var(--feed)"></view></view>
            <view class="dv">{{item.v}}<small>{{item.u}}</small></view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">
        <view class="et1">暂无喂养数据</view>
        <view class="et2">记录几笔奶量后这里会出现 7 天趋势</view>
      </view>
    </view>

    <!-- ============ 尿布 ============ -->
    <view class="chartcard anim" wx:if="{{seg === 'diaper'}}">
      <view class="ch-h">
        <view>
          <view class="h3">每日尿布次数</view>
          <view class="sub">点选某一天查看明细</view>
        </view>
        <view class="chip" wx:if="{{diaper.has}}">日均 {{diaper.avg}} 次</view>
      </view>
      <block wx:if="{{diaper.has}}">
        <view class="chart-box">
          <canvas type="2d" id="chCv" class="chart"></canvas>
          <view class="chart-hits">
            <view class="chart-hit" wx:for="{{chartRows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-hit" hover-stay-time="80" aria-role="button" aria-label="查看{{item.d}}" bindtap="onDayTap"></view>
          </view>
        </view>
        <view class="kpis">
          <view class="kpi" wx:for="{{diaper.kpis}}" wx:key="k">
            <view class="kv">{{item.v}}<small>{{item.u}}</small></view>
            <view class="kl">{{item.k}}</view>
          </view>
        </view>
        <view class="dlist">
          <view class="drow {{dayKey === item.key ? 'on' : ''}}" wx:for="{{diaper.rows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-row" hover-stay-time="60" bindtap="onDayTap">
            <text class="dd">{{item.d}}</text>
            <view class="dbar"><view class="di" style="width:{{item.p}}%;background:var(--diaper)"></view></view>
            <view class="dv">{{item.v}}<small>{{item.u}}</small></view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">
        <view class="et1">暂无尿布数据</view>
        <view class="et2">记录换尿布后这里会出现次数趋势</view>
      </view>
    </view>

    <!-- ============ 睡眠 ============ -->
    <view class="chartcard anim" wx:if="{{seg === 'sleep'}}">
      <view class="ch-h">
        <view>
          <view class="h3">每日睡眠时长</view>
          <view class="sub">点选某一天查看明细</view>
        </view>
        <view class="chip" wx:if="{{sleep.has}}">日均 {{sleep.avg}} h</view>
      </view>
      <block wx:if="{{sleep.has}}">
        <view class="chart-box">
          <canvas type="2d" id="chCv" class="chart"></canvas>
          <view class="chart-hits">
            <view class="chart-hit" wx:for="{{chartRows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-hit" hover-stay-time="80" aria-role="button" aria-label="查看{{item.d}}" bindtap="onDayTap"></view>
          </view>
        </view>
        <view class="kpis">
          <view class="kpi" wx:for="{{sleep.kpis}}" wx:key="k">
            <view class="kv">{{item.v}}<small>{{item.u}}</small></view>
            <view class="kl">{{item.k}}</view>
          </view>
        </view>
        <view class="dlist">
          <view class="drow {{dayKey === item.key ? 'on' : ''}}" wx:for="{{sleep.rows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-row" hover-stay-time="60" bindtap="onDayTap">
            <text class="dd">{{item.d}}</text>
            <view class="dbar"><view class="di" style="width:{{item.p}}%;background:var(--sleep)"></view></view>
            <view class="dv">{{item.v}}<small>{{item.u}}</small></view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">
        <view class="et1">暂无睡眠数据</view>
        <view class="et2">记录几段睡眠后这里会出现时长趋势</view>
      </view>
    </view>

    <!-- ============ 成长 ============ -->
    <view class="chartcard anim" wx:if="{{seg === 'growth'}}">
      <view class="ch-h">
        <view>
          <view class="h3">{{growth.metricName}}成长曲线</view>
          <view class="sub">{{growth.sub}}</view>
        </view>
        <view class="chip" wx:if="{{growth.has}}">{{growth.chip}}</view>
      </view>
      <view class="seg-inline gseg" wx:if="{{growth.has}}">
        <view class="si {{growthMetric==='weight'?'on':''}}" hover-class="hv-si" hover-stay-time="60" data-k="weight" bindtap="onGrowthMetric">体重</view>
        <view class="si {{growthMetric==='height'?'on':''}}" hover-class="hv-si" hover-stay-time="60" data-k="height" bindtap="onGrowthMetric">身高</view>
        <view class="si {{growthMetric==='head'?'on':''}}" hover-class="hv-si" hover-stay-time="60" data-k="head" bindtap="onGrowthMetric">头围</view>
      </view>
      <view class="pcthint" wx:if="{{growth.has && growth.pctText}}">{{growth.pctText}}</view>
      <block wx:if="{{growth.has}}">
        <view class="chart-box">
          <canvas type="2d" id="chCv" class="chart"></canvas>
          <view class="chart-hits">
            <view class="chart-hit" wx:for="{{chartRows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-hit" hover-stay-time="80" aria-role="button" aria-label="查看{{item.d}}" bindtap="onDayTap"></view>
          </view>
        </view>
        <view class="kpis">
          <view class="kpi" wx:for="{{growth.kpis}}" wx:key="k">
            <view class="kv">{{item.v}}<small>{{item.u}}</small></view>
            <view class="kl">{{item.k}}</view>
          </view>
        </view>
        <view class="dlist">
          <view class="drow {{dayKey === item.key ? 'on' : ''}}" wx:for="{{growth.rows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-row" hover-stay-time="60" bindtap="onDayTap">
            <text class="dd">{{item.d}}</text>
            <view class="dbar"><view class="di" style="width:{{item.p}}%;background:var(--growth)"></view></view>
            <view class="dv">{{item.v}}<small>{{item.u}}</small></view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">
        <view class="et1">暂无成长数据</view>
        <view class="et2">在「宝宝资料」填写出生体重，并记录测量值</view>
      </view>
    </view>

    <!-- ============ 体温 ============ -->
    <view class="chartcard anim" wx:if="{{seg === 'temp'}}">
      <view class="ch-h">
        <view>
          <view class="h3">早晚体温</view>
          <view class="sub">每天早、晚各取最新一次，点选查看当天</view>
        </view>
        <view class="chip" wx:if="{{temp.has}}">{{temp.chip}}</view>
      </view>
      <block wx:if="{{temp.has}}">
        <view class="chart-box" wx:if="{{temp.points.length >= 2}}">
          <canvas type="2d" id="chCv" class="chart"></canvas>
          <view class="chart-hits">
            <view class="chart-hit" wx:for="{{chartRows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-hit" hover-stay-time="80" aria-role="button" aria-label="查看{{item.label}}" bindtap="onDayTap"></view>
          </view>
        </view>
        <view class="kpis">
          <view class="kpi" wx:for="{{temp.kpis}}" wx:key="k">
            <view class="kv">{{item.v}}<small>{{item.u}}</small></view>
            <view class="kl">{{item.k}}</view>
          </view>
        </view>
        <view class="dlist">
          <view class="drow {{dayKey === item.key ? 'on' : ''}}" wx:for="{{temp.rows}}" wx:key="key" data-key="{{item.key}}" hover-class="hv-row" hover-stay-time="60" bindtap="onDayTap">
            <text class="dd">{{item.d}}</text>
            <view class="dbar"><view class="di" style="width:{{item.p}}%;background:var(--temp)"></view></view>
            <view class="dv wide">{{item.v}}</view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">
        <view class="et1">暂无体温数据</view>
        <view class="et2">早晚各记一次后，这里会出现近 7 天趋势</view>
      </view>
    </view>

    <view class="chartcard daycard anim" wx:if="{{dayOn}}">
      <view class="ch-h">
        <view>
          <view class="h3">{{dayTitle}}</view>
          <view class="sub">{{dayRows.length ? '左滑删除，点按修改' : '这一天没有对应记录'}}</view>
        </view>
      </view>
      <view class="card card-clip" wx:if="{{dayRows.length}}" style="margin:12px 0 0;box-shadow:none">
        <swipe-row
          wx:for="{{dayRows}}"
          wx:key="id"
          line="{{index > 0}}"
          disabled="{{!item.id || item.id === 'birth'}}"
          open="{{openId === item.id}}"
          data-id="{{item.id}}"
          bind:drag="onSwipeDrag"
          bind:open="onSwipeOpen"
          bind:close="onSwipeClose"
          bind:delete="onSwipeDelete"
        >
          <view class="row" data-id="{{item.id}}" hover-class="hv-row" hover-stay-time="60" bindtap="onDayRow">
            <view class="ric" style="background:var(--{{item.icBg}})">
              <image class="ric-ic" src="{{ic[item.iconKey]}}" mode="aspectFit" />
            </view>
            <view class="rbody">
              <view class="rt">{{item.title}}</view>
              <view class="rd">{{item.detail}}</view>
            </view>
            <view class="rr">{{item.hm}}</view>
          </view>
        </swipe-row>
      </view>
    </view>

    <view class="share-bar anim">
      <view class="share-btn {{sharing ? 'off' : ''}}" hover-class="hv-pill" hover-stay-time="80" bindtap="genShare">{{sharing ? '正在生成…' : '📤 生成摘要 / 周报长图'}}</view>
    </view>
  </scroll-view>

  <noise-dock id="noiseDock" />
  <toast id="toast" />
</view>
