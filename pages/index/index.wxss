/* 首页专属样式：接种倒计时 / 体温偏高提示横幅 / 奶量计算器入口 */

.calc-entry { margin: 14px 16px 0; }

/* 距下次接种横幅 */
.vac-banner {
  display: flex; align-items: center; gap: 12px;
  margin: 12px 16px 0; padding: 13px 14px;
  border-radius: var(--r-md); background: var(--growthS);
  box-shadow: var(--sh1);
}
.vac-ic { font-size: 22px; flex: none; line-height: 1; }
.vac-b { flex: 1; min-width: 0; }
.vac-t { font-size: 13px; font-weight: 700; color: var(--growth); }
.vac-n { color: var(--growth); font-weight: 800; }
.vac-s { font-size: 12px; color: var(--ink2); margin-top: 2px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 体温偏高提示横幅 */
.fever-banner {
  display: flex; align-items: center; gap: 12px;
  margin: 12px 16px 0; padding: 13px 14px;
  border-radius: var(--r-md); background: rgba(217,58,63,.12);
  box-shadow: var(--sh1);
}
.fever-ic { font-size: 22px; flex: none; line-height: 1; }
.fever-b { flex: 1; min-width: 0; }
.fever-t { font-size: 13px; font-weight: 700; color: var(--danger); }
.fever-s { font-size: 12px; color: var(--ink2); margin-top: 2px; }
