/* 类型分段固定；区间和图表在下方独立滚动，避免画布盖住分段 */

.stats-page {
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
}
.page.elder.stats-page { padding-bottom: 0; }

.stats-pin {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 16;
  padding-bottom: 6px;
  background: rgb(var(--bgRgb));
}
.stats-scroll {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 1;
}
.stats-scroll .share-bar { margin-bottom: 18px; }

.rng { margin: 12px 16px 0; }
.rng-pick { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
.rng-pick .rp {
  flex: 1; background: var(--fill); border-radius: var(--r-md);
  padding: 10px 12px; text-align: center; font-size: 14px; font-weight: 600; color: var(--ink);
}
.rng-pick .rp-sep { color: var(--ink3); font-size: 14px; font-weight: 700; }

/* 成长指标 Tab（复用 seg-inline 视觉，仅加间距） */
.gseg { margin: 12px 0 2px; }

/* WHO 百分位结论提示 */
.pcthint {
  margin: 10px 0 2px; font-size: 12.5px; font-weight: 700; color: var(--growth);
  background: var(--growthS); border-radius: 9px; padding: 7px 10px;
}

/* 分享摘要按钮 */
.share-bar { margin: 14px 16px 6px; }
.share-btn {
  text-align: center; padding: 13px; border-radius: var(--r-md);
  font-size: 14px; font-weight: 700; color: var(--priInk); background: var(--card);
  box-shadow: var(--sh1);
}
.share-btn.off { opacity: .55; pointer-events: none; }
