<view class="page t-{{theme}} {{dark ? 'dark' : ''}}">

  <!-- Hero：渐变头图 + 日龄 chip + 快速记一笔 -->
  <view class="hero" style="padding-top:{{navBottom}}px">
    <view class="hero-top">
      <view class="daychip">
        <image class="daychip-ic" src="{{ic.sun}}" mode="aspectFit" />
        <text>{{dayChip}}</text>
      </view>
      <view class="hero-add" hover-class="hv-add" hover-stay-time="80" bindtap="goAdd">
        <image class="hero-add-ic" src="{{ic.plus}}" mode="aspectFit" />
      </view>
    </view>
    <view class="hero-baby">
      <view class="hero-ava">
        <image class="hero-ava-ic" src="{{ic.baby}}" mode="aspectFill" />
      </view>
      <view>
        <view class="hero-nm">{{baby.name}}</view>
        <view class="hero-meta">{{heroMeta}}</view>
      </view>
    </view>
  </view>

  <!-- 浮出数据卡（今日 2×2） -->
  <view class="today anim">
    <view class="tcell" hover-class="hv-cell" hover-stay-time="80" bindtap="goHistory">
      <view class="tci" style="background:var(--feedS)">
        <image class="tci-ic" src="{{ic.feed}}" mode="aspectFit" />
      </view>
      <view class="tcv">{{today.feedCount}}<small>次</small></view>
      <view class="tcl">喂养次数</view>
    </view>
    <view class="tcell" hover-class="hv-cell" hover-stay-time="80" bindtap="goHistory">
      <view class="tci" style="background:var(--feedS)">
        <image class="tci-ic" src="{{ic.bottle}}" mode="aspectFit" />
      </view>
      <view class="tcv">{{today.feedMl}}<small>ml</small></view>
      <view class="tcl">总奶量</view>
    </view>
    <view class="tcell" hover-class="hv-cell" hover-stay-time="80" bindtap="goHistory">
      <view class="tci" style="background:var(--diaperS)">
        <image class="tci-ic" src="{{ic.diaper}}" mode="aspectFit" />
      </view>
      <view class="tcv">{{today.diaper}}<small>次</small></view>
      <view class="tcl">尿布</view>
    </view>
    <view class="tcell" hover-class="hv-cell" hover-stay-time="80" bindtap="goHistory">
      <view class="tci" style="background:var(--sleepS)">
        <image class="tci-ic" src="{{ic.sleep}}" mode="aspectFit" />
      </view>
      <view class="tcv">{{today.sleepText}}</view>
      <view class="tcl">睡眠</view>
    </view>
  </view>

  <!-- 下次喂养渐变焦点卡 + 环形进度 -->
  <view class="next anim" bindtap="onNextTap">
    <view class="next-l">
      <view class="next-t">距上次喂养</view>
      <block wx:if="{{hasFeed}}">
        <view class="next-big">{{next.since}}<small>分钟</small></view>
        <view class="next-s">{{next.sub}}</view>
      </block>
      <block wx:else>
        <view class="next-big">开始记录</view>
        <view class="next-s">点这里记下第一次喂养</view>
      </block>
    </view>
    <view class="next-ring">
      <canvas type="2d" id="ringCv" class="next-ring-cv"></canvas>
      <view class="rt">
        <b>{{next.nextHM}}</b>
        <span>{{hasFeed ? '下次建议' : '待记录'}}</span>
      </view>
    </view>
  </view>

  <!-- 最近记录 -->
  <view class="sec anim">最近记录</view>
  <view class="card anim">
    <block wx:if="{{!empty}}">
      <view
        class="row"
        wx:for="{{rows}}"
        wx:key="key"
        hover-class="hv-row"
        hover-stay-time="60"
        bindtap="goHistory"
      >
        <view class="ric" style="background:var(--{{r.icBg}})">
          <image class="ric-ic" src="{{ic[r.iconKey]}}" mode="aspectFit" />
        </view>
        <view class="rbody">
          <view class="rt">{{r.title}}</view>
          <view class="rd">{{r.detail}}</view>
        </view>
        <view class="rr">{{r.hm}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="empty">
        <image class="eic" src="{{ic.empty}}" mode="aspectFit" />
        <view class="et1">还没有记录</view>
        <view class="et2">点右上角 + 记下第一次喂养吧</view>
      </view>
    </block>
  </view>

  <toast id="toast" />
</view>
