.streak-page { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }

.streak-card { padding: 16px 16px 12px; overflow: visible; }
.streak-title { font-size: 16px; font-weight: 700; color: var(--ink); letter-spacing: -.2px; line-height: 1.35; }
.streak-n { font-size: 22px; font-weight: 800; color: var(--priInk); }
.streak-sub { margin-top: 4px; font-size: 13px; color: var(--ink3); font-weight: 500; line-height: 1.4; }

.track { position: relative; height: 44px; margin: 20px 14px 0; }
.track-line, .track-fill {
  position: absolute; left: 0; top: 5px; height: 4px; border-radius: 4px;
}
.track-line { right: 0; background: var(--fill); }
.track-fill { background: var(--pri2); }
.node {
  position: absolute; top: 1px; width: 12px; height: 12px;
  margin-left: -6px; border-radius: 50%; background: #D5D8E2;
}
.dark .node { background: #3A3E46; }
.node.on { background: var(--pri); }
.node-lb {
  position: absolute; top: 18px; left: 50%; transform: translateX(-50%);
  font-size: 12px; line-height: 1.2; color: var(--ink3); font-weight: 600; white-space: nowrap;
}

.cal-card { padding-bottom: 12px; }
.cal-hd { display: flex; align-items: center; padding: 4px 4px 0; }
.cal-title { flex: 1; text-align: center; font-size: 16px; font-weight: 700; color: var(--ink); }
.cal-nav {
  width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
  font-size: 22px; line-height: 1; color: var(--priInk); font-weight: 500;
}
.cal-nav.off { opacity: .28; }

.cal, .cal-week { /* Apply flexbox to both containers */
  display: flex;
  flex-wrap: wrap;
  padding: 0 4px; /* Reduced padding for more space */
}
.cal { padding-bottom: 8px; }

.cal-week text {
  width: calc(100% / 7); /* Strict 7-column width */
  flex-shrink: 0; /* Prevent shrinking */
  box-sizing: border-box;
  text-align: center; font-size: 12px; line-height: 28px;
  color: var(--ink3); font-weight: 600;
}

.cell {
  width: calc(100% / 7); /* Strict 7-column width */
  flex-shrink: 0; /* Prevent shrinking */
  height: 44px;
  box-sizing: border-box; /* padding handled by cell-in margin */
  overflow: hidden;
}
.cell-in { /* The inner box with background and border */
  height: 38px; border-radius: 10px; background: var(--fill);
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 600; color: var(--ink2);
  margin: 3px; /* Margin to create spacing between cells */
  overflow: hidden; box-sizing: border-box;
}
.cell.out .cell-in { color: var(--ink3); opacity: .45; }
.cell.hit .cell-in { background: var(--priSoft); color: var(--priInk); opacity: 1; }
.cell.is-today .cell-in { color: var(--priInk); border: 1.5px solid var(--pri); background: var(--card); }
.cell.is-today.hit .cell-in { background: var(--pri); color: #fff; box-shadow: none; }
