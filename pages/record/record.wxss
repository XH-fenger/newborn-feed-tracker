/* 记录页专属样式 */
.pickers { display: flex; gap: 10px; }
.pk { flex: 1; min-width: 0; }
.ph { color: var(--ink3); font-weight: 400; }
.dur-show {
  background: var(--fill); border-radius: var(--r-md);
  padding: 13px 14px; font-size: 16px; font-weight: 700;
  color: var(--pri); font-variant-numeric: tabular-nums;
}
.btn-del {
  display: block; width: calc(100% - 32px); margin: 12px 16px 0;
  border-radius: var(--r-md); padding: 15px; font-size: 16px; font-weight: 700;
  color: var(--danger); text-align: center; line-height: 1.4;
  box-shadow: inset 0 0 0 1.5px var(--danger);
  transition: transform .18s;
}

/* 体温偏高提示 + 联动用药 */
.fever-warn {
  margin-top: 12px; padding: 12px; border-radius: var(--r-md);
  background: rgba(217,58,63,.1);
}
.fever-warn-t { font-size: 13px; font-weight: 700; color: var(--danger); }
.btn-med {
  margin-top: 10px; display: inline-block; padding: 9px 16px; border-radius: 999px;
  font-size: 13px; font-weight: 700; color: var(--priInk); background: var(--priSoft);
}

/* 同上一次（一键重复） */
.rep {
  display: flex; align-items: center; gap: 10px;
  margin: 12px 16px 0; padding: 11px 14px;
  background: var(--priSoft); border-radius: var(--r-md);
}
.rep-ic {
  width: 30px; height: 30px; flex: none; border-radius: 50%;
  background: var(--card); color: var(--pri);
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; font-weight: 700;
}
.rep-body { flex: 1; min-width: 0; }
.rep-k { font-size: 13px; font-weight: 700; color: var(--priInk); }
.rep-v {
  margin-top: 2px; font-size: 12.5px; font-weight: 500; color: var(--ink2);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.rep-go { flex: none; font-size: 13px; font-weight: 700; color: var(--pri); }
