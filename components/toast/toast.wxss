.toast {
  position: fixed; left: 50%; bottom: calc(150px + env(safe-area-inset-bottom));
  transform: translate(-50%, 10px);
  background: rgba(14, 26, 25, .9);
  backdrop-filter: blur(10px);
  color: #fff; padding: 12px 22px 12px 18px;
  border-radius: 24px; font-size: 14px; font-weight: 600;
  opacity: 0; pointer-events: none;
  transition: opacity .26s, transform .26s;
  z-index: 35; white-space: nowrap;
  display: flex; align-items: center; gap: 9px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, .3);
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }
.t-ic { width: 16px; height: 16px; flex: none; }
.t-tx { color: #fff; }
