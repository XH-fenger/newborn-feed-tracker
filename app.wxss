/* 动效降级（系统层面：跟随系统减弱动画设置） */
@media (prefers-reduced-motion: reduce) {
  .anim, .drow .di { animation-duration: .001s; }
  .seg-thumb, .switch .knob, .chev { transition-duration: .001s; }
}
