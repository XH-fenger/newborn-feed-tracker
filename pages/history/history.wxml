<view class="page t-{{theme}} {{dark ? 'dark' : ''}} {{elder ? 'elder' : ''}}">

  <view class="nav {{navSc ? 'sc' : ''}}" style="padding-top:{{sbH}}px">
    <view class="nav-row nav-row-pad" style="min-height:{{navH}}px">
      <view class="nav-back" hover-class="hv-si" hover-stay-time="60" bindtap="onBack">
        <image class="nav-back-ic" src="{{icBack}}" mode="aspectFit" />
        <text>首页</text>
      </view>
      <view class="nav-mid">共 {{total}} 条</view>
    </view>
  </view>

  <view class="page-body" style="padding-top:{{sbH + navH + 10}}px">

    <view class="seg seg-6 anim">
      <view class="seg-thumb" style="transform:translateX({{segIndex * 100}}%)"></view>
      <view
        wx:for="{{filters}}" wx:key="k"
        class="seg-item {{filter === item.k ? 'on' : ''}}"
        hover-class="hv-seg" hover-stay-time="60"
        data-k="{{item.k}}" data-i="{{index}}"
        bindtap="onSegTap"
      >{{item.t}}</view>
    </view>

    <block wx:if="{{groups.length}}">
      <block wx:for="{{groups}}" wx:for-item="g" wx:key="key">
        <view class="sec anim">{{g.label}}</view>
        <view class="card card-clip anim">
          <swipe-row
            wx:for="{{g.rows}}"
            wx:key="id"
            line="{{index > 0}}"
            open="{{openId === item.id}}"
            data-id="{{item.id}}"
            bind:drag="onSwipeDrag"
            bind:open="onSwipeOpen"
            bind:close="onSwipeClose"
            bind:delete="onSwipeDelete"
          >
            <view class="row" data-id="{{item.id}}" hover-class="hv-row" hover-stay-time="60" bindtap="onRowTap">
              <view class="ric" style="background:var(--{{item.icBg}})">
                <image class="ric-ic" src="{{ic[item.iconKey]}}" mode="aspectFit" />
              </view>
              <view class="rbody">
                <view class="rt">{{item.title}}</view>
                <view class="rd">{{item.detail}}</view>
              </view>
              <view class="rr">{{item.hm}}</view>
            </view>
          </swipe-row>
        </view>
      </block>
    </block>

    <view class="card anim" wx:else>
      <view class="empty">
        <image class="eic" src="{{ic.empty}}" mode="aspectFit" />
        <view class="et1">暂无{{emptyLabel}}记录</view>
        <view class="et2">切到「记一笔」开始记录吧</view>
      </view>
    </view>

  </view>

  <noise-dock id="noiseDock" />
  <toast id="toast" />
</view>
