.sw { position: relative; overflow: hidden; background: var(--card); }
.sw-del {
  position: absolute; right: 0; top: 0; bottom: 0; width: 76px;
  display: flex; align-items: center; justify-content: center;
  background: var(--danger); color: #fff;
  font-size: 15px; font-weight: 600; letter-spacing: .5px;
}
.sw-main { position: relative; z-index: 1; background: var(--card); }
.sw-main.anim { transition: transform .22s cubic-bezier(.22, 1, .36, 1); }
.sw-line {
  position: absolute; z-index: 2; top: 0; left: 64px; right: 0; height: 1px;
  background: var(--line); pointer-events: none;
}
@media (prefers-reduced-motion: reduce) {
  .sw-main.anim { transition: none; }
}
