<view class="page t-{{theme}} {{dark ? 'dark' : ''}} {{elder ? 'elder' : ''}}">

  <!-- 未滚动时透明，头图从状态栏铺下来；滚动后浮现毛玻璃 -->
  <view class="nav nav-blank {{navSc ? 'sc' : ''}}" style="padding-top:{{sbH}}px;height:{{navBottom}}px"></view>

  <view class="profile" style="padding-top:{{sbH}}px">
    <view class="profile-hd" style="min-height:{{navH}}px;padding-right:{{capsuleRight}}px" hover-class="hv-prof" hover-stay-time="60" bindtap="goBaby">
        <view class="pava">
          <image class="pava-ic" src="{{ic.baby}}" mode="aspectFill" />
          <view class="pen">
            <image class="pen-ic" src="{{ic.pen}}" mode="aspectFit" />
          </view>
        </view>
        <view class="profile-txt">
          <view class="pnm">{{profile.name}}</view>
          <view class="pmt">{{profile.meta}}</view>
        </view>
        <text class="chev">›</text>
      </view>
      <view class="profile-stats">
        <view class="pstat"><b>{{profile.count}}<small>条</small></b><span>累计记录</span></view>
        <view class="pstat" hover-class="hv-pstat" hover-stay-time="60" bindtap="goStreak"><b>{{profile.days}}<small>天</small></b><span>已坚持</span></view>
        <view class="pstat"><b>{{profile.daily}}<small>条</small></b><span>日均</span></view>
      </view>
    </view>

  <view class="page-body">
    <view class="sec anim">常用</view>
    <view class="card anim">
      <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="goHistory">
        <view class="ric" style="background:var(--feedS)">
          <image class="ric-ic" src="{{ic.records}}" mode="aspectFit" />
        </view>
        <view class="rbody">
          <view class="rt">查看记录</view>
          <view class="rd">喂养、尿布、睡眠、体温和洗澡</view>
        </view>
        <view class="rr">{{profile.count ? profile.count + ' 条' : ''}} <text class="chev">›</text></view>
      </view>
      <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="goTodo">
        <view class="ric" style="background:var(--priSoft)">
          <image class="ric-ic" src="{{ic.todo}}" mode="aspectFit" />
        </view>
        <view class="rbody">
          <view class="rt">待办</view>
          <view class="rd">疫苗、体检和其它安排</view>
        </view>
        <view class="rr">{{todoOpen ? todoOpen + ' 件' : ''}} <text class="chev">›</text></view>
      </view>
      <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="goSettings">
        <view class="ric" style="background:var(--sleepS)">
          <image class="ric-ic" src="{{ic.sliders}}" mode="aspectFit" />
        </view>
        <view class="rbody">
          <view class="rt">设置</view>
          <view class="rd">提醒、外观、深色和老年模式</view>
        </view>
        <view class="rr">{{themeName}} <text class="chev">›</text></view>
      </view>
    </view>

    <view class="sec anim">数据</view>
    <view class="card anim">
      <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="goData">
        <view class="ric" style="background:var(--growthS)">
          <image class="ric-ic" src="{{ic.down}}" mode="aspectFit" />
        </view>
        <view class="rbody">
          <view class="rt">数据</view>
          <view class="rd">导出、导入、分享摘要和清空</view>
        </view>
        <text class="chev">›</text>
      </view>
    </view>

    <view class="card anim">
      <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="openFeedback">
        <view class="ric" style="background:var(--priSoft)">
          <image class="ric-ic" src="{{ic.chat}}" mode="aspectFit" />
        </view>
        <view class="rbody">
          <view class="rt">问题反馈 / 建议</view>
          <view class="rd">使用中有问题，或想加功能，点这里说说</view>
        </view>
        <text class="chev">›</text>
      </view>
      <!-- 推荐给朋友：小程序未认证，分享暂不可用，先隐藏
      <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="openShare">
        <view class="ric" style="background:var(--sleepS)">
          <image class="ric-ic" src="{{ic.share}}" mode="aspectFit" />
        </view>
        <view class="rbody">
          <view class="rt">推荐给朋友</view>
          <view class="rd">小程序码，可保存或发给微信好友</view>
        </view>
        <text class="chev">›</text>
      </view>
      -->
      <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="goLog">
        <view class="ric" style="background:var(--growthS)">
          <image class="ric-ic" src="{{ic.log}}" mode="aspectFit" />
        </view>
        <view class="rbody">
          <view class="rt">更新日志</view>
          <view class="rd">{{logHint}}</view>
        </view>
        <text class="chev">›</text>
      </view>
      <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="onThanks">
        <view class="ric" style="background:var(--tempS)">
          <image class="ric-ic" src="{{ic.heart}}" mode="aspectFit" />
        </view>
        <view class="rbody">
          <view class="rt">创造不易，感谢支持</view>
          <view class="rd">你的支持，是继续做下去的动力</view>
        </view>
        <text class="chev">›</text>
      </view>
    </view>

    <view class="foot anim">喂养记录 v1.0.0<br />数据全部保存在本机，不上传云端</view>
  </view>

  <!-- 推荐给朋友弹窗，与上面入口一起恢复
  <view class="fb-mask" wx:if="{{shareOpen}}" bindtap="closeShare">
    <view class="fb-card share-card" catchtap="noop">
      <view class="fb-t">推荐给朋友</view>
      <view class="fb-note">微信扫一扫即可打开。长按图片也可以保存或发送。</view>
      <image wx:if="{{!codeMissing}}" class="share-code" src="{{codeImg}}" mode="aspectFit" show-menu-by-longpress="{{true}}" binderror="onCodeError" />
      <view class="share-empty" wx:if="{{codeMissing}}">小程序码图片还没放进安装包。请把公众平台下载的码保存为 assets/mp-code.png 后重新编译。</view>
      <view class="share-acts">
        <view class="share-act" hover-class="hv-row" hover-stay-time="60" bindtap="saveCode">保存图片</view>
        <button class="share-act share-act-pri" hover-class="share-act-on" hover-stay-time="60" open-type="share">分享给好友</button>
      </view>
      <view class="fb-close" hover-class="hv-row" hover-stay-time="60" bindtap="closeShare">关闭</view>
    </view>
  </view>
  -->

  <view class="fb-mask" wx:if="{{fbOpen}}" bindtap="closeFeedback">
    <view class="fb-card" catchtap="noop">
      <view class="fb-t">问题反馈 / 建议</view>
      <view class="fb-note">使用中遇到问题，或有想加的功能，添加微信或发邮件即可沟通。</view>
      <view class="fb-note">也可按你的需求，承接软件定制开发。</view>
      <view class="fb-row" hover-class="hv-row" hover-stay-time="60" data-k="wx" bindtap="copyFeedback">
        <view class="fb-k">微信号</view>
        <view class="fb-v">{{fbWxMask}}</view>
        <view class="fb-copy">复制</view>
      </view>
      <view class="fb-row" hover-class="hv-row" hover-stay-time="60" data-k="mail" bindtap="copyFeedback">
        <view class="fb-k">邮箱</view>
        <view class="fb-v">{{fbMailMask}}</view>
        <view class="fb-copy">复制</view>
      </view>
      <view class="fb-close" hover-class="hv-row" hover-stay-time="60" bindtap="closeFeedback">关闭</view>
    </view>
  </view>

  <noise-dock id="noiseDock" />
  <toast id="toast" />
</view>
