.page.elder .row { min-height: 64px; padding-top: 14px; padding-bottom: 14px; }
.page.elder .ric { width: 44px; height: 44px; }
.page.elder .ric-ic { width: 22px; height: 22px; }
.page.elder .row + .row::before { left: 74px; }
.page.elder .rt { font-size: 19px; line-height: 1.35; }
.page.elder .rd,
.page.elder .rr .unit { font-size: 15.5px; line-height: 1.4; }
