<view class="page home-v{{homeVer}} t-{{theme}} {{dark ? 'dark' : ''}} {{elder ? 'elder' : ''}}">

  <!-- Hero：渐变头图 + 日龄 chip -->
  <view class="hero">
    <view class="hero-nav" style="padding-top:{{sbH}}px;height:{{navBottom}}px;padding-right:{{capsuleRight}}px">
      <view class="daychip-slot" style="top:{{sbH}}px;height:{{navH}}px">
        <view class="daychip">
          <image class="daychip-ic" src="{{ic.sun}}" mode="aspectFit" />
          <text>{{dayChip}}</text>
        </view>
      </view>
      <view class="hero-top">
        <view class="hero-theme" hover-class="hv-theme" hover-stay-time="80" bindtap="toggleDark" aria-role="switch" aria-checked="{{dark}}" aria-label="深色模式">
          <view class="hero-theme-dot">
            <image class="hero-theme-ic" src="{{dark ? ic.sunBtn : ic.moonBtn}}" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>
    <view class="hero-baby">
      <view class="hero-ava">
        <image class="hero-ava-ic" src="{{ic.baby}}" mode="aspectFill" />
      </view>
      <view>
        <view class="hero-nm">{{baby.name}}</view>
        <view class="hero-meta">{{heroMeta}}</view>
      </view>
    </view>
  </view>

  <!-- 布局 v1：紧凑四宫格。homeVer 改回 1 即恢复 -->
  <block wx:if="{{homeVer === 1}}">
  <view class="today anim">
    <view class="tcell" hover-class="hv-cell" hover-stay-time="80" data-type="feed" bindtap="goHistory">
      <view class="tci" style="background:var(--feedS)">
        <image class="tci-ic" src="{{ic.feed}}" mode="aspectFit" />
      </view>
      <view class="tcv">{{today.feedCount}}<small>次</small></view>
      <view class="tcl">喂养次数</view>
    </view>
    <view class="tcell" hover-class="hv-cell" hover-stay-time="80" data-type="feed" bindtap="goHistory">
      <view class="tci" style="background:var(--feedS)">
        <image class="tci-ic" src="{{ic.bottle}}" mode="aspectFit" />
      </view>
      <view class="tcv">{{today.feedMl}}<small>ml</small></view>
      <view class="tcl">总奶量</view>
    </view>
    <view class="tcell" hover-class="hv-cell" hover-stay-time="80" data-type="diaper" bindtap="goHistory">
      <view class="tci" style="background:var(--diaperS)">
        <image class="tci-ic" src="{{ic.diaper}}" mode="aspectFit" />
      </view>
      <view class="tcv">{{today.diaper}}<small>次</small></view>
      <view class="tcl">尿布</view>
    </view>
    <view class="tcell" hover-class="hv-cell" hover-stay-time="80" data-type="sleep" bindtap="goHistory">
      <view class="tci" style="background:var(--sleepS)">
        <image class="tci-ic" src="{{ic.sleep}}" mode="aspectFit" />
      </view>
      <view class="tcv">{{today.sleepText}}</view>
      <view class="tcl">睡眠</view>
    </view>
  </view>

  <view class="card card-clip calc-entry anim">
    <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="goCalc">
      <view class="ric" style="background:var(--feedS)">
        <image class="ric-ic" src="{{ic.bottle19}}" mode="aspectFit" />
      </view>
      <view class="rbody">
        <view class="rt">奶量计算器</view>
        <view class="rd">区分母乳和配方奶，可算强化剂克数</view>
      </view>
      <text class="chev">›</text>
    </view>
    <view class="row" hover-class="hv-row" hover-stay-time="60" bindtap="goNoise">
      <view class="ric" style="background:var(--sleepS)">
        <image class="ric-ic" src="{{ic.sleep19}}" mode="aspectFit" />
      </view>
      <view class="rbody">
        <view class="rt">白噪音哄睡</view>
        <view class="rd">吹风机、雨声、海浪，可调音量</view>
      </view>
      <text class="chev">›</text>
    </view>
  </view>

  <view class="tempday anim">
    <view class="tempday-h">
      <text class="tempday-t">今日体温</text>
      <text class="tempday-sub">早晚各测一次</text>
    </view>
    <view class="tempday-row">
      <view class="tslot {{todayTemp.am.empty ? 'empty' : ''}}" hover-class="hv-cell" hover-stay-time="80" data-slot="am" bindtap="onTempTap">
        <view class="tslot-k">早测</view>
        <view class="tslot-v {{todayTemp.am.hi ? 'hi' : ''}} {{todayTemp.am.lo ? 'lo' : ''}}">{{todayTemp.am.text}}<small wx:if="{{!todayTemp.am.empty}}">°C</small></view>
        <view class="tslot-s">{{todayTemp.am.sub}}</view>
      </view>
      <view class="tslot {{todayTemp.pm.empty ? 'empty' : ''}}" hover-class="hv-cell" hover-stay-time="80" data-slot="pm" bindtap="onTempTap">
        <view class="tslot-k">晚测</view>
        <view class="tslot-v {{todayTemp.pm.hi ? 'hi' : ''}} {{todayTemp.pm.lo ? 'lo' : ''}}">{{todayTemp.pm.text}}<small wx:if="{{!todayTemp.pm.empty}}">°C</small></view>
        <view class="tslot-s">{{todayTemp.pm.sub}}</view>
      </view>
    </view>
  </view>

  <!-- 下次喂养渐变焦点卡 + 环形进度 -->
  <view class="next anim" hover-class="hv-next" hover-stay-time="80" bindtap="onNextTap">
    <view class="next-l">
      <view class="next-t">距上次喂养</view>
      <block wx:if="{{hasFeed}}">
        <view class="next-big">{{next.hh}}<small>时</small>{{next.mm}}<small>分</small></view>
        <view class="next-s">{{next.sub}}</view>
      </block>
      <block wx:else>
        <view class="next-big">开始记录</view>
        <view class="next-s">点这里记下第一次喂养</view>
      </block>
    </view>
    <view class="next-ring">
      <canvas type="2d" id="ringCv" class="next-ring-cv"></canvas>
      <view class="rt">
        <b>{{next.nextHM}}</b>
        <span>{{hasFeed ? '下次' : '待记录'}}</span>
      </view>
    </view>
  </view>
  </block>

  <!-- 布局 v2：参考 Baby Buddy 仪表盘，上次喂养在前，今日数据一行，工具并排 -->
  <block wx:else>
    <view class="next anim" hover-class="hv-next" hover-stay-time="80" bindtap="onNextTap">
      <view class="next-l">
        <view class="next-t">距上次喂养</view>
        <block wx:if="{{hasFeed}}">
          <view class="next-big">{{next.hh}}<small>时</small>{{next.mm}}<small>分</small></view>
          <view class="next-s">{{next.sub}}</view>
        </block>
        <block wx:else>
          <view class="next-big">开始记录</view>
          <view class="next-s">点这里记下第一次喂养</view>
        </block>
      </view>
      <view class="next-ring">
        <canvas type="2d" id="ringCv" class="next-ring-cv"></canvas>
        <view class="rt">
          <b>{{next.nextHM}}</b>
          <span>{{hasFeed ? '下次' : '待记录'}}</span>
        </view>
      </view>
    </view>

    <view class="statline anim">
      <view class="stat" hover-class="hv-cell" hover-stay-time="80" data-type="feed" bindtap="goHistory">
        <b>{{today.feedCount}}</b>
        <text>喂养</text>
      </view>
      <view class="stat" hover-class="hv-cell" hover-stay-time="80" data-type="feed" bindtap="goHistory">
        <b>{{today.feedMl}}</b>
        <text>奶量 ml</text>
      </view>
      <view class="stat" hover-class="hv-cell" hover-stay-time="80" data-type="diaper" bindtap="goHistory">
        <b>{{today.diaper}}</b>
        <text>尿布</text>
      </view>
      <view class="stat" hover-class="hv-cell" hover-stay-time="80" data-type="sleep" bindtap="goHistory">
        <b class="stat-sleep">{{today.sleepText}}</b>
        <text>睡眠</text>
      </view>
    </view>

    <view class="toolgrid anim">
      <view class="tool" hover-class="hv-cell" hover-stay-time="80" bindtap="goCalc">
        <view class="tool-ic" style="background:var(--feedS)">
          <image class="tool-ic-img" src="{{ic.bottle19}}" mode="aspectFit" />
        </view>
        <view class="tool-t">奶量计算</view>
      </view>
      <view class="tool" hover-class="hv-cell" hover-stay-time="80" bindtap="goNoise">
        <view class="tool-ic" style="background:var(--sleepS)">
          <image class="tool-ic-img" src="{{ic.sleep19}}" mode="aspectFit" />
        </view>
        <view class="tool-t">白噪音</view>
      </view>
    </view>

    <view class="tempday anim">
      <view class="tempday-h">
        <text class="tempday-t">今日体温</text>
        <text class="tempday-sub">早晚各测一次</text>
      </view>
      <view class="tempday-row">
        <view class="tslot {{todayTemp.am.empty ? 'empty' : ''}}" hover-class="hv-cell" hover-stay-time="80" data-slot="am" bindtap="onTempTap">
          <view class="tslot-k">早测</view>
          <view class="tslot-v {{todayTemp.am.hi ? 'hi' : ''}} {{todayTemp.am.lo ? 'lo' : ''}}">{{todayTemp.am.text}}<small wx:if="{{!todayTemp.am.empty}}">°C</small></view>
          <view class="tslot-s">{{todayTemp.am.sub}}</view>
        </view>
        <view class="tslot {{todayTemp.pm.empty ? 'empty' : ''}}" hover-class="hv-cell" hover-stay-time="80" data-slot="pm" bindtap="onTempTap">
          <view class="tslot-k">晚测</view>
          <view class="tslot-v {{todayTemp.pm.hi ? 'hi' : ''}} {{todayTemp.pm.lo ? 'lo' : ''}}">{{todayTemp.pm.text}}<small wx:if="{{!todayTemp.pm.empty}}">°C</small></view>
          <view class="tslot-s">{{todayTemp.pm.sub}}</view>
        </view>
      </view>
    </view>
  </block>

  <view class="fever-banner anim" wx:if="{{fever}}" hover-class="hv-cell" hover-stay-time="80" bindtap="goMed">
    <view class="fever-ic">🌡️</view>
    <view class="fever-b">
      <view class="fever-t">体温偏高，建议记录用药</view>
      <view class="fever-s">点此在「记录」中补一笔补充剂 / 用药</view>
    </view>
    <text class="chev">›</text>
  </view>

  <view class="vac-banner anim" wx:if="{{vacCard}}" hover-class="hv-cell" hover-stay-time="80" bindtap="goTodo">
    <view class="vac-ic">💉</view>
    <view class="vac-b">
      <view class="vac-t">距下次接种 · <text class="vac-n">{{vacCard.daysText}}</text></view>
      <view class="vac-s">{{vacCard.title}} · {{vacCard.when}}</view>
    </view>
    <text class="chev">›</text>
  </view>

  <view class="sec sec-row sec-tap anim" wx:if="{{todoPreview.length}}" hover-class="hv-sec" hover-stay-time="80" bindtap="goTodo">
    即将到来<text class="secv">{{todoMore ? '还有 ' + todoMore + ' 件' : '全部'}}</text>
  </view>
  <view class="card card-clip anim" wx:if="{{todoPreview.length}}">
    <view
      class="row"
      wx:for="{{todoPreview}}"
      wx:key="id"
      hover-class="hv-row"
      hover-stay-time="60"
      bindtap="goTodo"
    >
      <view class="ric" style="background:var(--{{item.icBg}})">
        <image class="ric-ic" src="{{ic[item.iconKey]}}" mode="aspectFit" />
      </view>
      <view class="rbody">
        <view class="rt">{{item.title}}</view>
        <view class="rd">待办</view>
      </view>
      <view class="rr {{item.late ? 'danger' : ''}}">{{item.when}}</view>
    </view>
  </view>
  <view class="sec sec-row sec-tap anim" wx:else hover-class="hv-sec" hover-stay-time="80" bindtap="goTodo">
    待办<text class="secv">疫苗、体检</text>
  </view>

  <!-- 最近记录 -->
  <view class="sec anim">最近记录</view>
  <view class="card card-clip anim">
    <block wx:if="{{!empty}}">
      <swipe-row
        wx:for="{{rows}}"
        wx:for-item="r"
        wx:key="key"
        line="{{index > 0}}"
        open="{{openId === r.key}}"
        data-id="{{r.key}}"
        bind:drag="onSwipeDrag"
        bind:open="onSwipeOpen"
        bind:close="onSwipeClose"
        bind:delete="onSwipeDelete"
      >
        <view class="row" data-id="{{r.key}}" hover-class="hv-row" hover-stay-time="60" bindtap="onRecentTap">
          <view class="ric" style="background:var(--{{r.icBg}})">
            <image class="ric-ic" src="{{ic[r.iconKey]}}" mode="aspectFit" />
          </view>
          <view class="rbody">
            <view class="rt">{{r.title}}</view>
            <view class="rd">{{r.detail}}</view>
          </view>
          <view class="rr">{{r.hm}}</view>
        </view>
      </swipe-row>
    </block>
    <block wx:else>
      <view class="empty">
        <image class="eic" src="{{ic.empty}}" mode="aspectFit" />
        <view class="et1">还没有记录</view>
        <view class="et2">切到底部「记录」记下第一次喂养吧</view>
      </view>
    </block>
  </view>

  <noise-dock id="noiseDock" />
  <toast id="toast" />
</view>
