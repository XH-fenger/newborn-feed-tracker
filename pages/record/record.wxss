/* 记录页专属样式 */
.pickers { display: flex; gap: 10px; }
.pk { flex: 1; min-width: 0; }
.ph { color: var(--ink3); font-weight: 400; }
.dur-show {
  background: var(--fill); border-radius: var(--r-md);
  padding: 13px 14px; font-size: 16px; font-weight: 700;
  color: var(--pri); font-variant-numeric: tabular-nums;
}
.btn-del {
  display: block; width: calc(100% - 32px); margin: 12px 16px 0;
  border-radius: var(--r-md); padding: 15px; font-size: 16px; font-weight: 700;
  color: var(--danger); text-align: center; line-height: 1.4;
  box-shadow: inset 0 0 0 1.5px var(--danger);
  transition: transform .18s;
}
